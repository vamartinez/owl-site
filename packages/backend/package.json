{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "AI Construction Compliance Platform - Backend Services & Infrastructure",
  "scripts": {
    "build": "rm -rf dist/services && esbuild --bundle --platform=node --target=node20 --outdir=dist/services src/services/*/handler.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:properties": "vitest run tests/properties",
    "lint": "eslint src/ tests/ --ext .ts",
    "deploy:dev": "cdk deploy --all --context environment=dev",
    "deploy:prod": "cdk deploy --all --context environment=prod",
    "smoke:dev": "ENVIRONMENT=dev bash scripts/smoke-test-deploy.sh",
    "smoke:prod": "ENVIRONMENT=prod bash scripts/smoke-test-deploy.sh",
    "build:reset-dev-data": "esbuild scripts/reset-dev-data.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/scripts/reset-dev-data.cjs --external:@aws-sdk/*",
    "reset:dev-data": "pnpm build:reset-dev-data && ENVIRONMENT=dev node dist/scripts/reset-dev-data.cjs",
    "reset:dev-data:dry-run": "pnpm build:reset-dev-data && ENVIRONMENT=dev node dist/scripts/reset-dev-data.cjs --dry-run",
    "synth": "cdk synth"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent": "^3.540.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1057.0",
    "@aws-sdk/client-bedrock-data-automation-runtime": "^3.540.0",
    "@aws-sdk/client-bedrock-runtime": "^3.540.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.540.0",
    "@aws-sdk/client-dynamodb": "^3.540.0",
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/client-scheduler": "^3.1057.0",
    "@aws-sdk/client-secrets-manager": "^3.540.0",
    "@aws-sdk/client-ses": "^3.540.0",
    "@aws-sdk/client-sns": "^3.540.0",
    "@aws-sdk/client-sqs": "^3.540.0",
    "@aws-sdk/lib-dynamodb": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "aws-cdk-lib": "^2.140.0",
    "constructs": "^10.3.0",
    "jsonwebtoken": "^9.0.2",
    "ollama": "^0.6.0",
    "pdfkit": "^0.15.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.0",
    "@types/uuid": "^9.0.8",
    "aws-cdk": "^2.140.0",
    "esbuild": "^0.20.0",
    "fast-check": "^3.17.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
